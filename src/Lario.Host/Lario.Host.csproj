<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    Lario.Host: API, Authentifizierung (ab Schritt 7), Konfiguration und
    die statische Weboberfläche aus frontend/.
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Lario.Infrastructure\Lario.Infrastructure.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <FrontendDist>$(MSBuildThisFileDirectory)../../frontend/dist/host/browser</FrontendDist>
  </PropertyGroup>

  <!-- Vorab gebautes Frontend (npm run build:host) in die wwwroot des Host-Outputs kopieren. -->
  <!-- Ohne Build-Artefakt bleibt die API unveraendert nutzbar. -->
  <ItemGroup Condition="Exists('$(FrontendDist)/index.html')">
    <Content Include="$(FrontendDist)/**" LinkBase="wwwroot" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
