{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm"
  },
  "newProjectRoot": "apps",
  "defaultProject": "host",
  "projects": {
    "host": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/host",
      "sourceRoot": "apps/host/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/host/src/main.ts",
            "outputPath": "dist/host",
            "tsConfig": "apps/host/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/host/public"
              }
            ],
            "styles": ["apps/host/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "host:build:production"
            },
            "development": {
              "buildTarget": "host:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/host/**/*.ts", "apps/host/**/*.html"],
            "eslintConfig": "apps/host/eslint.config.js"
          }
        }
      }
    },
    "mobile": {
      "projectType": "application",
      "schematics": {},
      "root": "apps/mobile",
      "sourceRoot": "apps/mobile/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "apps/mobile/src/main.ts",
            "outputPath": "dist/mobile",
            "tsConfig": "apps/mobile/tsconfig.app.json",
            "assets": [
              {
                "glob": "**/*",
                "input": "apps/mobile/public"
              }
            ],
            "styles": ["apps/mobile/src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "mobile:build:production"
            },
            "development": {
              "buildTarget": "mobile:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test"
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": ["apps/mobile/**/*.ts", "apps/mobile/**/*.html"],
            "eslintConfig": "apps/mobile/eslint.config.js"
          }
        }
      }
    }
  }
}
